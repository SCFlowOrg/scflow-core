{
  "name": "@scfloworg/core-plugin-core",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Pure runtime of core-plugin: one MCL dataset per document, shared built-in schemas, undo/redo through core transactions, filtered MclAccess, and a test helper for business packages.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "docs/business-model.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests/"
  },
  "dependencies": {
    "@scfloworg/core": "^0.1.0",
    "@scfloworg/format-js": "^0.1.0"
  }
}
