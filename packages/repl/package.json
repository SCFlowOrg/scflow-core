{
  "name": "@scfloworg/repl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive REPL for the Model Command Language: named dataset contexts, incremental scripting with result and snippet variables. See README.md.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "model-repl": "dist/cli.js",
    "scflow": "dist/scflowCli.js"
  },
  "exports": {
    "./scflow": {
      "types": "./dist/scflow.d.ts",
      "default": "./dist/scflow.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scfloworg/actions": "^0.1.0",
    "@scfloworg/ai": "^0.1.0",
    "@scfloworg/core": "^0.1.0",
    "@scfloworg/format-js": "^0.1.0",
    "@scfloworg/workspace": "^0.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
