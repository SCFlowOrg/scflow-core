{
  "name": "@scfloworg/environment",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "The environment of SCFlow: the catalogue of modules with their code, formats given at creation, open datasets, the context of actions and the transaction of one action. See README.md.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scfloworg/actions": "^0.1.0",
    "@scfloworg/core": "^0.1.0",
    "@scfloworg/module": "^0.1.0"
  },
  "devDependencies": {
    "@scfloworg/conformance": "^0.1.0",
    "@scfloworg/format-js": "^0.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
