{
  "name": "@scfloworg/module-scflow-core",
  "description": "Business package of the supply chain flow model: MCL schemas and pure domain logic.",
  "version": "2.0.0-next.2",
  "type": "module",
  "files": [
    "dist",
    "docs",
    "module.yaml",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-schemas.mjs && node scripts/build-docs.mjs && tsc -b && tsc -p tsconfig.module.json && node scripts/build-module.mjs",
    "test": "node scripts/build-schemas.mjs && vitest run"
  },
  "dependencies": {
    "@scfloworg/core": "^0.2.0-next.2"
  },
  "devDependencies": {
    "@scfloworg/docs": "^0.1.0",
    "@scfloworg/environment": "^0.2.0-next.2",
    "@scfloworg/format-js": "^0.2.0-next.2",
    "@scfloworg/module": "^0.2.0-next.2",
    "@scfloworg/spreadsheet": "^0.2.0-next.2",
    "@types/node": "^22.10.0",
    "js-yaml": "^5.4.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCFlowOrg/scflow-core.git",
    "directory": "packages/module-scflow-core"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
