{
  "name": "@scfloworg/spreadsheet",
  "version": "0.2.0-next.1",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "description": "Converts an MCL dataset to rows of sheets and back: the export writes one sheet per named entity type, the import resolves names and writes through the actions of the model, in one transaction. No file format, no UI. See README.md.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scfloworg/core": "^0.2.0-next.1"
  },
  "devDependencies": {
    "@scfloworg/environment": "^0.2.0-next.1",
    "@scfloworg/format-js": "^0.2.0-next.1",
    "@scfloworg/module": "^0.2.0-next.1",
    "@types/node": "^22.10.0",
    "js-yaml": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCFlowOrg/scflow-core.git",
    "directory": "packages/spreadsheet"
  }
}
