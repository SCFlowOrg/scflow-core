{
  "name": "@scfloworg/ai",
  "version": "0.1.0-next.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "description": "The neutral AI package: the types of a conversation with a language model, connections, an OpenAI-compatible transport over fetch, model profiles, normalized errors, usage reports and the agent loop. No dependency. See README.md.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@scfloworg/actions": "^0.1.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCFlowOrg/scflow-core.git",
    "directory": "packages/ai"
  }
