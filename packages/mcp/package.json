{
  "name": "@scfloworg/mcp",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "description": "An MCP server on the SCFlow workspace: an MCP client works on a project on disk through its actions. See README.md.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "scflow-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@scfloworg/actions": "^0.1.0",
    "@scfloworg/core": "^0.1.0",
    "@scfloworg/environment": "^0.1.0",
    "@scfloworg/workspace": "^0.1.0"
  },
  "devDependencies": {
    "@scfloworg/repl": "^0.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCFlowOrg/scflow-core.git",
    "directory": "packages/mcp"
  }
}
