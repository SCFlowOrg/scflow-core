{
  "name": "@scfloworg/workspace",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "The workspace of SCFlow: documents, their sections, transactions and undo, over an environment. No UI. See README.md.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scfloworg/core": "^0.1.0",
    "@scfloworg/environment": "^0.1.0",
    "@scfloworg/format-file": "^0.1.0",
    "@scfloworg/project-file": "^0.1.0"
  },
  "devDependencies": {
    "@scfloworg/format-js": "^0.1.0",
    "@scfloworg/module": "^0.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
