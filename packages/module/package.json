{
  "name": "@scfloworg/module",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "The code of a module package: defineModule, the build of one bundle per module package, the bundle check and modules.load. See README.md.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./reference": {
      "types": "./dist/reference.d.ts",
      "default": "./dist/reference.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "default": "./dist/code.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./yaml": {
      "types": "./yaml.d.ts"
    },
    "./markdown": {
      "types": "./markdown.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "yaml.d.ts",
    "markdown.d.ts"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scfloworg/core": "^0.1.0",
    "acorn": "^8.18.0",
    "eslint-scope": "^8.4.0",
    "js-yaml": "^4.1.0",
    "rolldown": "1.2.1"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
